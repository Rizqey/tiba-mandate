# Runtime-only values. Do not save a real key in this repository.
# Public receiving address for the local paid endpoint (Solana devnet).
TIBA_X402_PAY_TO=

# Base58-encoded 64-byte Solana devnet secret key. The client never prints it.
TIBA_X402_SVM_PRIVATE_KEY=

# The client is deliberately opt-in before it can create a devnet payment.
TIBA_X402_CONFIRM=devnet

# Optional local endpoint override; host must remain loopback.
# TIBA_X402_ENDPOINT=http://127.0.0.1:4021/paid
